{
	"info": {
		"_postman_id": "mini-erp-inventory-api-v1",
		"name": "Mini ERP Inventory & Purchase Order API",
		"description": "API collection for Mini ERP Inventory & Purchase Order Management System (Laravel 12, Sanctum Auth).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login (Get Sanctum Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Logout (Revoke Token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"logout"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Inventory",
			"item": [
				{
					"name": "List All Products (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/inventory?page=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"inventory"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "List Low Stock Products",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/inventory/low-stock",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"inventory",
								"low-stock"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Purchase Orders",
			"item": [
				{
					"name": "Create Purchase Order",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"supplier_id\": 1,\n    \"items\": [\n        {\n            \"product_id\": 1,\n            \"quantity\": 5,\n            \"unit_price\": 1200.00\n        },\n        {\n            \"product_id\": 2,\n            \"quantity\": 10,\n            \"unit_price\": 75.00\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/purchase-orders",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"purchase-orders"
							]
						}
					},
					"response": []
				},
				{
					"name": "Transition PO Status to APPROVED",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"APPROVED\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/purchase-orders/1/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"purchase-orders",
								"1",
								"status"
							]
						}
					},
					"response": []
				},
				{
					"name": "Transition PO Status to RECEIVED (Atomic Stock Increment)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"RECEIVED\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/purchase-orders/1/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"purchase-orders",
								"1",
								"status"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Reports",
			"item": [
				{
					"name": "Supplier Spend Report (DB Aggregated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/reports/supplier-spend",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"reports",
								"supplier-spend"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}
